# BUCLE no necesita ninguna variable de entorno para funcionar en modo
# demostración: toda la configuración vive en src/config/*.ts. Este archivo
# documenta las variables opcionales para desplegar en distintos entornos.

# URL pública del sitio, usada por metadataBase, el sitemap y el JSON-LD.
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Solo necesario para GitHub Pages: nombre del repositorio como basePath
# (con barra inicial, ej. /bucle-web). Se establece automáticamente en el
# workflow de despliegue — no hace falta definirlo en local ni en Vercel.
# NEXT_PUBLIC_BASE_PATH=/bucle-web

# --- Cuando se sustituya el checkout de demostración por uno real ---
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Cuando se conecte el formulario de contacto o la newsletter a un backend ---
# RESEND_API_KEY=
# CONTACT_FORM_ENDPOINT=
